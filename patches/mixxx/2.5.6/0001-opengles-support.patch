+  add_library(OpenGLES::OpenGLES INTERFACE IMPORTED)
+  set_target_properties(OpenGLES::OpenGLES PROPERTIES
+    INTERFACE_LINK_LIBRARIES "${GLESv2_LIBRARY};${EGL_LIBRARY}"
+    INTERFACE_INCLUDE_DIRECTORIES "${GLES2_INCLUDE_DIR};${EGL_INCLUDE_DIR}"
+  )
+  target_link_libraries(mixxx-lib PRIVATE OpenGLES::OpenGLES)
+  target_compile_definitions(mixxx-lib PUBLIC QT_OPENGL_ES_2)
 else()
   if(APPLE)
     # Prefer the system-provided OpenGL framework on macOS to avoid accidentally
@@ -3255,9 +3268,11 @@
   if(QT6)
     find_package(X11)
   else()
-    find_package(X11 REQUIRED)
