   target_link_libraries(mixxx-lib PRIVATE "-framework OpenGLES")
   target_compile_definitions(mixxx-lib PUBLIC QT_OPENGL_ES_2)
+elseif(OPENGL STREQUAL "ES")
+  # OpenGL ES via EGL (embedded systems: Mali GPU, etc.)
