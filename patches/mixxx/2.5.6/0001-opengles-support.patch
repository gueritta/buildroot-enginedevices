+    find_package(X11)
+    if(X11_FOUND)
+      find_package(Qt5 COMPONENTS X11Extras)
+      target_link_libraries(mixxx-lib PUBLIC Qt5::X11Extras)
+    endif()
   endif()
   if(${X11_FOUND})
     target_include_directories(mixxx-lib SYSTEM PUBLIC "${X11_INCLUDE_DIR}")
