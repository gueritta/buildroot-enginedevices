+                m_openGLVersion += majorVersion == 0 ? QString("None") : versionString;
+            }
 
             // Qt5 requires at least OpenGL 2.1 or OpenGL ES 2.0
-            if (pContext->isOpenGLES()) {
-                if (majorVersion * 100 + minorVersion >= 200) {
