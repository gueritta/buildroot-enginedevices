[Unit]
Description=MIXXX DJ Software
After=sound.target multi-user.target
Conflicts=engine.service
Before=engine.service

[Service]
Type=simple
ExecStart=/usr/bin/mixxx_launcher.sh
Restart=on-failure
RestartSec=2
Environment=HOME=/root
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_INTEGRATION=eglfs_emu
Environment=QT_QPA_EGLFS_KMS_ATOMIC=1
Environment=QT_QPA_EGLFS_ROTATION=90
Environment=QT_QPA_EGLFS_DEBUG=0

# Real-time audio
LimitRTPRIO=99
LimitMEMLOCK=infinity
